{
  "$schema": "https://www.schemastore.org/wrangler.json",
  "name": "bickriservice-agency",
  "main": "./worker.js",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "bickriservice-agency.bickriserviceagency.dev",
      "custom_domain": true
    },
    {
      "pattern": "bickriservice-agency.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/s/*"
    ]
  },
  "vars": {
    "AI_API_URL": "https://api.openai.com/v1/responses",
    "OPENAI_MODEL": "gpt-4.1-mini",
    "AI_MODEL": "gpt-4.1-mini",
    "TURNSTILE_HOSTNAMES": "bickriservice-agency.org,www.bickriservice-agency.org,bickriservice-agency.vercel.app,bickriservice-agency.bickriserviceagency.dev",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFSQKBE9BhCCTI8Qc1vlZ_sojAI"
  },
  "send_email": [
    {
      "name": "PARTNER_EMAIL",
      "destination_address": "bickriserviceagency@gmail.com",
      "allowed_sender_addresses": [
        "partenaires@bickriservice-agency.org"
      ]
    }
  ]
}
