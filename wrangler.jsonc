{
  "$schema": "https://www.schemastore.org/wrangler.json",
  "name": "bickriservice-agency",
  "main": "./worker.js",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "bickriservice-agency.bickriserviceagency.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
